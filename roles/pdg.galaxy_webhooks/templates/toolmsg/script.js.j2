// Custom messages for tool forms, based on the usegalaxy.eu toolmsg webhook

const enableDebug = false;
const debugLog = (msg) => enableDebug && console.debug("[ToolMsg]: " + msg);

const WAIT_TOOL_MAX_TRIES = 3;
const WAIT_TOOL_INTERVAL = 500;
const toolMessages = [
{% for message in galaxy_webhooks_toolmsg_messages %}
    {
        tool_id: {{ message.tool_id | to_json }},
        message: {{ message.message | trim | to_json }},
        class: {{ message.class | default('info') | to_json }}
    },
{% endfor %}
];
const anonymousMessage = {{ galaxy_webhooks_toolmsg_anonymous_message | trim | to_json }};

function insertMessage(message, alertClass) {
    const newElement = document.createElement('p');
    newElement.className = 'alert alert-' + alertClass + ' my-3';
    newElement.innerHTML = message;
    const referenceElement = document.getElementById('tool-card-body');
    if (referenceElement) {
        referenceElement.parentNode.insertBefore(newElement, referenceElement);
    } else {
        debugLog('Reference element with id="tool-card-body" not found.');
    }
}

// Anonymous visitors get no user id from the API
function showAnonymousMessage() {
    if (!anonymousMessage) {
        return;
    }
    const root = (window.Galaxy && window.Galaxy.root) || '/';
    fetch(root + 'api/users/current', { credentials: 'same-origin' })
        .then((response) => response.json())
        .then((user) => {
            if (!user.id) {
                insertMessage(anonymousMessage, 'warning');
            }
        })
        .catch((error) => debugLog('User check failed: ' + error));
}

function waitToolFormLoad() {
    tries++;
    let matched = false;
    const element = document.querySelector('div[tool_id]');
    if (element) {
        debugLog('Tool form has been loaded');
        showAnonymousMessage();
        matched = showToolMessages();
        tries = WAIT_TOOL_MAX_TRIES;
    } else {
        debugLog("No tool form detected (tries: " + tries + ")");
    }
    tries < WAIT_TOOL_MAX_TRIES
        && !matched
        && setTimeout(waitToolFormLoad, WAIT_TOOL_INTERVAL);
}

function isCurrentToolForm(toolId) {
    const elements = document.querySelectorAll('[tool_id]');
    for (let element of elements) {
        const thisToolId = element.getAttribute('tool_id');
        if (thisToolId && thisToolId.startsWith(toolId)) {
            debugLog(toolId + " matches " + thisToolId);
            return true;
        }
    }
    debugLog(toolId + " not found in page.");
    return false;
}

function showToolMessages() {
    let match = false;
    toolMessages.forEach( (toolMessage) => {
        if (isCurrentToolForm(toolMessage.tool_id)) {
            insertMessage(toolMessage.message, toolMessage.class);
            match = true;
        }
    })
    return match;
}

let tries = 0;
let lastUrlPath = null;

// Re-check after each client-side page change
const observer = new MutationObserver( () => {
    if (lastUrlPath !== window.location.href) {
        debugLog("Triggered mutation observer");
        tries = 0;
        lastUrlPath = window.location.href;
        setTimeout(waitToolFormLoad, 500);
    }
});

observer.observe(document.body, { childList: true, subtree: true });
