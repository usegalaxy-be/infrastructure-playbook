#!/bin/bash

. ~/.bashrc

stat_timeout=0.1 # seconds
ftp_dir={{ galaxy_ftp_upload_dir }}

# check ftp_dir status. 
timeout -s kill $stat_timeout stat -t $ftp_dir > /dev/null
if [[ ! $? == 137 ]];  then
	for user_email in $(psql -c 'COPY (select email from galaxy_user) TO STDOUT WITH CSV'); do
		mkdir -p "$ftp_dir/$user_email"
	done;
fi
