          "datasource": {"type": "influxdb", "uid": "be-galaxy-new"},
          "query": "SELECT last(\"claimed_cpus\") AS \"in use\", last(\"unclaimed_cpus\") AS \"available\", last(\"total_detected_cpus\") AS \"total\" FROM \"htcondor_cluster_usage\" WHERE \"classad\" = 'machine' AND $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
