    {
      "id": 8,
      "type": "table",
      "title": "Potentially broken tools, most used first",
      "description": "Broken (every test that ran failed) or a regression. Users and jobs are from the last 90 days without service accounts. 'open run' links to the test output. Click a tool_id for the errors of its failed tests.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "be-galaxy-new"
          },
          "rawQuery": true,
          "query": "SELECT last(\"version\") AS \"version\", last(\"status\") AS \"status\", last(\"tests_pass\") AS \"tests passed\", last(\"tests_tool\") AS \"tests failed\", last(\"tests_infra\") AS \"infra errors\", last(\"tests_setup\") AS \"setup problems\", last(\"potentially_broken\") AS \"potentially_broken\", last(\"regression\") AS \"regression\", last(\"regression_from\") AS \"passes in\", last(\"expected_failure\") AS \"expected_failure\", last(\"expected_reason\") AS \"expected reason\", last(\"failed_runs\") AS \"failed runs\", last(\"runs\") AS \"runs\", last(\"tested_at\") * 1000 AS \"tested\", last(\"run\") AS \"run\", last(\"details\") AS \"details\" FROM \"tool_test\" WHERE time > now() - 2h GROUP BY \"tool_id\"",
          "refId": "A",
          "resultFormat": "table"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "be-internal-metrics"
          },
          "rawQuery": true,
          "query": "SELECT last(\"users_90d\") AS \"users 90d\", last(\"jobs_90d\") AS \"jobs 90d\", last(\"errors_90d\") AS \"errors 90d\", last(\"error_rate_90d\") AS \"error rate 90d\", last(\"users_30d\") AS \"users 30d\", last(\"jobs_30d\") AS \"jobs 30d\" FROM \"tool_usage\" WHERE time > now() - 13h GROUP BY \"tool_id\"",
          "refId": "B",
          "resultFormat": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "tool_id",
            "mode": "outer"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "potentially_broken",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": 1
                  }
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "potentially_broken": true,
              "expected_failure": true,
              "expected reason": true,
              "details": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "users 90d",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "passed": {
                        "color": "green",
                        "text": "passed",
                        "index": 0
                      },
                      "partial": {
                        "color": "orange",
                        "text": "partial",
                        "index": 1
                      },
                      "broken": {
                        "color": "red",
                        "text": "broken",
                        "index": 2
                      },
                      "infra": {
                        "color": "purple",
                        "text": "infra error",
                        "index": 3
                      },
                      "untestable": {
                        "color": "text",
                        "text": "untestable",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tested"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Workflow run",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".+",
                      "result": {
                        "text": "open run",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tool_id"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 380
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Failed tests of this tool",
                    "url": "${__data.fields.details}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "regression"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": ""
                      },
                      "1": {
                        "text": "yes",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error rate 90d"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.1
                    },
                    {
                      "color": "red",
                      "value": 0.3
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
