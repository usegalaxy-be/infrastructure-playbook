      "datasource": {
        "type": "influxdb",
        "uid": "be-galaxy-new"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "be-galaxy-new"
          },
          "rawQuery": true,
          "query": "SELECT last(\"version\") AS \"version\", last(\"status\") AS \"status\", last(\"success\") AS \"passed\", last(\"failure\") AS \"failed\", last(\"error\") AS \"errored\", last(\"skip\") AS \"skipped\", last(\"potentially_broken\") AS \"potentially_broken\", last(\"expected_failure\") AS \"expected_failure\", last(\"expected_reason\") AS \"expected_reason\", last(\"tested_at\") * 1000 AS \"tested\", last(\"run\") AS \"run\" FROM \"tool_test\" WHERE time > now() - 2h GROUP BY \"tool_id\", \"repository\"",
          "refId": "A",
          "resultFormat": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "potentially_broken": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "tested",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          },
          "noValue": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "passed": {
                        "color": "green",
                        "text": "passed",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "text": "failed",
                        "index": 1
                      },
                      "skipped": {
                        "color": "text",
                        "text": "skipped",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tested"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Workflow run",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".+",
                      "result": {
                        "text": "open run",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tool_id"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 420
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Results over time",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "influxdb",
        "uid": "be-galaxy-new"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "be-galaxy-new"
          },
          "rawQuery": true,
          "query": "SELECT last(\"passed\") AS \"passed\", last(\"potentially_broken\") AS \"potentially broken\", last(\"expected_failures\") AS \"expected failures\" FROM \"tool_test_summary\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "potentially broken"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "expected failures"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      }
    }
  ]
