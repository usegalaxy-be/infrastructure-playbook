          "rawQuery": true,
          "query": "SELECT sum(\"v\") FROM (SELECT last(\"users_90d\") AS \"v\" FROM \"tool_usage\" WHERE \"tool\" = '$tool' AND time > now() - 13h GROUP BY \"tool_id\")",
          "refId": "A"
