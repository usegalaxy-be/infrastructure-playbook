      "title": "Cluster Allocation by Group",
      "description": "CPU cores and memory allocation fraction per cluster/group. Source: cluster.alloc measurement.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "be-galaxy-new"},
          "query": "SELECT mean(\"cores\") FROM \"cluster.alloc\" WHERE $timeFilter GROUP BY time($__interval), \"cluster\", \"group\" fill(none)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        },
        {
          "datasource": {"type": "influxdb", "uid": "be-galaxy-new"},
          "query": "SELECT mean(\"memory\") FROM \"cluster.alloc\" WHERE $timeFilter GROUP BY time($__interval), \"cluster\", \"group\" fill(none)",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "datasource": {"type": "influxdb", "uid": "be-galaxy-new"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Allocation fraction",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
