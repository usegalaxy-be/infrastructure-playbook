        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "title": "Total Cluster Allocation",
      "description": "Overall CPU and memory allocation fraction across the entire HTCondor pool.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "be-galaxy-new"},
          "query": "SELECT mean(\"cores\") AS \"CPU\" FROM \"cluster.alloc\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
