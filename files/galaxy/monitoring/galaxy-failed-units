#!/bin/bash
# Counts systemd units in "failed" state (any unit), plus one point per failed unit.
# Outputs InfluxDB line protocol.
# Deployed to /usr/bin/galaxy-failed-units, telegraf exec interval 5m.

units=$(systemctl list-units --state=failed --no-legend --plain 2>/dev/null | awk '{print $1}')

count=0
for unit in $units; do
    count=$((count + 1))
    # Escape tag value for line protocol
    tag=$(printf '%s' "$unit" | sed 's/[ ,=]/\\&/g')
    printf 'galaxy_failed_unit,unit=%s failed=1i\n' "$tag"
done

printf 'galaxy_failed_units count=%si\n' "$count"
