#!/usr/bin/env python3
# galaxy-tool-usage
# Per-tool usage from the Galaxy database, without the given service accounts.
#   tool_usage: per tool version, jobs, distinct users and errored jobs over 30 and 90 days
#   tool_usage_monthly: per tool (all versions), jobs and users per month for the
#     last 13 months, timestamped at the start of the month so reruns overwrite
# Outputs InfluxDB line protocol. libpq reads PGHOST/PGDATABASE/PGUSER/PGPASSWORD.
#
# Deployed to: /usr/bin/galaxy-tool-usage
# Telegraf exec plugin interval: 6h
#
# Usage: galaxy-tool-usage [excluded_username ...]

import sys

import psycopg2

# Tool Shed ids without their version, other tool ids unchanged.
TOOL_KEY = "CASE WHEN tool_id LIKE '%%/repos/%%' THEN regexp_replace(tool_id, '/[^/]*$', '') ELSE tool_id END"

USAGE_SQL = f"""
SELECT tool_id, {TOOL_KEY} AS tool,
       count(*) FILTER (WHERE create_time > now() - interval '30 days'),
       count(DISTINCT user_id) FILTER (WHERE create_time > now() - interval '30 days'),
       count(*) FILTER (WHERE create_time > now() - interval '30 days' AND state = 'error'),
       count(*),
       count(DISTINCT user_id),
       count(*) FILTER (WHERE state = 'error')
FROM job
WHERE create_time > now() - interval '90 days'
  AND user_id NOT IN (SELECT id FROM galaxy_user WHERE username = ANY(%(excluded)s))
GROUP BY 1, 2
"""

MONTHLY_SQL = f"""
SELECT {TOOL_KEY} AS tool,
       extract(epoch FROM date_trunc('month', create_time))::bigint,
       count(*),
       count(DISTINCT user_id),
       count(*) FILTER (WHERE state = 'error')
FROM job
WHERE create_time >= date_trunc('month', now()) - interval '12 months'
  AND user_id NOT IN (SELECT id FROM galaxy_user WHERE username = ANY(%(excluded)s))
GROUP BY 1, 2
"""


def tag(value):
    return str(value).replace("\\", "\\\\").replace(" ", "\\ ").replace(",", "\\,").replace("=", "\\=") or "none"


def repository(tool_id):
    parts = tool_id.split("/")
    return f"{parts[2]}/{parts[3]}" if len(parts) > 4 and parts[1] == "repos" else "built-in"


def main():
    params = {"excluded": sys.argv[1:]}
    conn = psycopg2.connect("")
    try:
        with conn.cursor() as cur:
            cur.execute(USAGE_SQL, params)
            for tool_id, tool, jobs30, users30, err30, jobs90, users90, err90 in cur.fetchall():
                rate = err90 / jobs90 if jobs90 else 0.0
                print(f"tool_usage,tool_id={tag(tool_id)},tool={tag(tool)},repository={tag(repository(tool_id))} "
                      f"jobs_30d={jobs30}i,users_30d={users30}i,errors_30d={err30}i,"
                      f"jobs_90d={jobs90}i,users_90d={users90}i,errors_90d={err90}i,error_rate_90d={rate:.4f}")
            cur.execute(MONTHLY_SQL, params)
            for tool, month, jobs, users, errors in cur.fetchall():
                print(f"tool_usage_monthly,tool={tag(tool)} jobs={jobs}i,users={users}i,errors={errors}i {month * 10**9}")
    finally:
        conn.close()


if __name__ == "__main__":
    main()
