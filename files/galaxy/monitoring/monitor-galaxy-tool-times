#!/bin/bash
# monitor-galaxy-tool-times
# Reports per-destination queue and run times for jobs running longer than 90s.
# Outputs InfluxDB line protocol.
#
# Deployed to: /usr/bin/monitor-galaxy-tool-times
# Telegraf exec plugin interval: 10m
#
# Requires env vars set by custom_telegraf_env:
#   PGHOST, PGDATABASE, PGUSER, PGPASSWORD, GALAXY_ROOT, GALAXY_CONFIG_FILE

gxadmin iquery destination-queue-run-time --seconds --older-than=90 \
  | awk -F, '$2 != "destination_id=" { print }'
