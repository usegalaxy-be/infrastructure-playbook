 logging.getLogger("irods.connection").setLevel(logging.INFO)  # irods logging generates gigabytes of logs
 
 
+# Number of attempts (initial try + retries) for a transient iRODS connection error.
+_IRODS_RETRY_ATTEMPTS = 3
+# Base backoff in seconds; the wait before attempt N is _IRODS_RETRY_BACKOFF * N.
+_IRODS_RETRY_BACKOFF = 0.5
+
+
+def _retry_on_connection_error(func):
+    """Retry an idempotent iRODS operation after a transient connection error.
+
+    Two failure modes are covered:
+      * A pooled connection silently reset by a firewall/proxy: python-irodsclient
+        raises NetworkException on first use and destroys the connection.
+      * The iRODS backend dropping the TLS handshake of a freshly opened
+        connection under load, surfacing as ssl.SSLError (e.g. SSLEOFError,
+        raised from an empty pool creating a new connection).
+    Both clear on a new connection, so a few bounded retries with a short backoff
+    turn a transient blip into a successful call instead of a failed job. Used by
+    idempotent reads (_get_remote_size / _exists_remotely / _download), by
+    _delete (already treats "object not found" as success, so a retry after a
+    partial delete is safe), and by _push_to_storage (create/put both use the
+    iRODS FORCE_FLAG, so a retried upload just overwrites whatever the interrupted
+    attempt left behind).
+    """
+
+    @functools.wraps(func)
+    def wrapper(*args, **kwargs):
+        for attempt in range(1, _IRODS_RETRY_ATTEMPTS + 1):
+            try:
+                return func(*args, **kwargs)
+            except (NetworkException, ssl.SSLError) as exc:
+                if attempt == _IRODS_RETRY_ATTEMPTS:
+                    log.warning("iRODS %s failed after %d attempts: %s", func.__name__, attempt, exc)
+                    raise
+                log.warning(
+                    "Transient iRODS error in %s (attempt %d/%d), retrying on a fresh connection: %s",
+                    func.__name__, attempt, _IRODS_RETRY_ATTEMPTS, exc,
+                )
+                time.sleep(_IRODS_RETRY_BACKOFF * attempt)
+
+    return wrapper
+
+
