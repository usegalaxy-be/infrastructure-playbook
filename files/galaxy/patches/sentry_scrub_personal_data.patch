diff --git a/lib/galaxy/config/schemas/config_schema.yml b/lib/galaxy/config/schemas/config_schema.yml
index ce03424c8a..28705f6502 100644
--- a/lib/galaxy/config/schemas/config_schema.yml
+++ b/lib/galaxy/config/schemas/config_schema.yml
@@ -2514,6 +2514,22 @@ mapping:
           performance traces sent to Sentry. Independent of
           sentry_traces_sample_rate, which controls server-side tracing.
 
+      sentry_scrub_personal_data:
+        type: bool
+        default: false
+        required: false
+        desc: |
+          Remove personal data from Sentry events before they are sent. When
+          enabled, Galaxy drops user details, cookies, request bodies, the
+          client address and stack frame variables from each event, and keeps
+          only the template of log messages, not the values passed to them. It
+          masks e-mail addresses, IP addresses, API keys, tokens and session
+          cookies in messages, exceptions and breadcrumbs. Usernames and ids in
+          free text cannot be recognised and are sent as they are.
+          Browser-side error reporting is turned off, as browsers connect to
+          the Sentry server directly and so share the user's IP address with
+          it.
+
       sentry_ca_certs:
         type: str
         required: False
