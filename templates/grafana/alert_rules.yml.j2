  # ── TPV Job Tests ────────────────────────────────────────────────────────────
  # Data source: tpv_job_test measurement written by the job healthcheck (pdg.galaxy_healthcheck).
  # Runs every 2h from cron on each Galaxy host, and on demand via daily-galaxy-healthcheck.yml.
  # noDataState: Alerting catches both job failures and a stopped/broken cron.
  # 3.5h window ensures at least one run is always in scope (runs every 2h, take ≤1h).
  # host tag added to line protocol so test and prod can be alerted separately.

  # Split by persistence, because a single failed batch and a destination that
  # has been broken all morning are not the same event.
  #
  #   warning  — one batch failed. The healthcheck already retries up to 3 times
  #              within a batch, so this is not a blip, but it is not a page
  #              either. Self-resolves when the next batch (2h later) passes.
  #   critical — no successful run for that tool in 5.5h, sustained across at
  #              least one further batch (for: 2h15m). A hiccup that recovers on
  #              the next batch clears the pending state and never pages.
  #
  # Both GROUP BY "tool" so the notification names the destination that failed
  # instead of collapsing all seven into one anonymous value. Several tools
  # failing at once still arrive as one message: the notification policy groups
  # by severity, not by rule.
  - orgId: 1
    name: TPV Job Test Failure
    folder: Galaxy Alerts
    interval: 5m
    rules:

      - uid: be-tpv-job-test-failure
        title: TPV Test Job Failed (prod)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 12600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT min("ok") FROM "tpv_job_test"
                WHERE host = 'usegalaxy.be' AND $timeFilter
                GROUP BY "tool"
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: Alerting
        execErrState: Alerting
        for: 0s
        labels:
          severity: warning
          env: prod
        annotations:
          summary: >-
            TPV test job {% raw %}{{ $labels.tool }}{% endraw %} failed on prod (or the healthcheck cron has stopped)
          description: >-
            {% raw %}{{ $labels.tool }}{% endraw %} did not complete ok on usegalaxy.be in the last 3.5
            hours, after the healthcheck's own retries. If no tool has reported at
            all, the cron has stopped instead.
            It clears by itself if the next 2-hourly batch passes; it escalates to
            critical if it does not.
            ssh usegalaxy.be 'gxadmin query queue-detail'
            tail ~/logs/galaxy-healthcheck.log on the loginnode

      - uid: be-tpv-job-test-sustained
        title: TPV Test Job Failing Repeatedly (prod)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 19800
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT max("ok") FROM "tpv_job_test"
                WHERE host = 'usegalaxy.be' AND $timeFilter
                GROUP BY "tool"
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: OK
        execErrState: OK
        for: 2h15m
        labels:
          severity: critical
          env: prod
        annotations:
          summary: >-
            TPV test job {% raw %}{{ $labels.tool }}{% endraw %} has not passed on prod in over 5 hours
          description: >-
            {% raw %}{{ $labels.tool }}{% endraw %} has failed every healthcheck batch for 5+ hours on
            usegalaxy.be, so this is not a transient failure: that destination is
            not running jobs.
            ssh usegalaxy.be 'gxadmin query queue-detail'
            ssh usegalaxy.be 'condor_q -better-analyze'
            tail ~/logs/galaxy-healthcheck.log on the loginnode

      - uid: be-tpv-job-test-failure-test
        title: TPV Test Job Failed (test)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 12600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT min("ok") FROM "tpv_job_test"
                WHERE host = 'test.usegalaxy.be' AND $timeFilter
                GROUP BY "tool"
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: Alerting
        execErrState: Alerting
        for: 0s
        labels:
          severity: warning
          env: test
        annotations:
          summary: >-
            TPV test job {% raw %}{{ $labels.tool }}{% endraw %} failed on test (or the healthcheck cron has stopped)
          description: >-
            {% raw %}{{ $labels.tool }}{% endraw %} did not complete ok on test.usegalaxy.be in the last
            3.5 hours. If no tool has reported at all, the cron has stopped instead.
            ssh test.usegalaxy.be 'gxadmin query queue-detail'

  # ── Database Backup ──────────────────────────────────────────────────────────
  # Data source: galaxy-backup-freshness (telegraf exec, hourly) → galaxy_backup.
  # offsite_age_hours comes from a marker backup_db.sh writes only after the
  # MinIO upload exits 0, so a failing upload shows as a rising age.
  # -1 means the marker is missing (never succeeded since deploy), which the
  # outside_range evaluator treats the same as stale.
  #
  # This exists because the previous offsite copy (scp to midas.psb.ugent.be)
  # failed every night from Feb 2024 with nothing watching it: the only signal
  # was cron mail, which queued undelivered in ~/.esmtp_queue for 2.5 years.

  - orgId: 1
    name: Database Backup Stale
    folder: Galaxy Alerts
    interval: 10m
    rules:

      - uid: be-backup-offsite-stale
        title: Offsite DB Backup Stale (prod)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 10800
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT last("offsite_age_hours") FROM "galaxy_backup"
                WHERE "host" = 'usegalaxy.be' AND $timeFilter
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: outside_range
                    params: [0, 30]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: Alerting
        execErrState: Alerting
        for: 30m
        labels:
          severity: warning
          env: prod
        annotations:
          summary: No successful offsite DB backup in over 30 hours
          description: >-
            The nightly upload to MinIO has not succeeded since more than one
            night ago, or has never succeeded since this check was deployed.
            No data at all means telegraf stopped reporting it.
            ssh usegalaxy.be 'tail -20 ~/cron.log'
            ssh usegalaxy.be '/usr/local/bin/mcli ls vibminio/usegalaxy-be/db_backups/prod/ | tail -3'

      - uid: be-backup-offsite-critical
        title: Offsite DB Backup Failing (prod)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 10800
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT last("offsite_age_hours") FROM "galaxy_backup"
                WHERE "host" = 'usegalaxy.be' AND $timeFilter
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [50]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: OK
        execErrState: OK
        for: 30m
        labels:
          severity: critical
          env: prod
        annotations:
          summary: Offsite DB backup has missed two consecutive nights
          description: >-
            usegalaxy.be has had no successful offsite database backup for 50+
            hours. Two nights in a row is a real failure, not a transient one.
            ssh usegalaxy.be 'tail -20 ~/cron.log'
            ssh usegalaxy.be '/srv/galaxy/shared/database/backup/scripts/backup_db.sh'

