# Grafana Unified Alerting — Alert Rules
# Deployed to: /etc/grafana/provisioning/alerting/alert_rules.yml
#
# Datasource UID referenced: be-galaxy-new  (GalaxyNew, database: galaxy)
# All thresholds are intentionally conservative; tune after observing normal baselines.
#
# NOTE: Each rule is in its own group to work around a Grafana 11.4.0 bug where
# batch-inserting multiple rules in the same group causes UNIQUE constraint failures
# on the alert_rule.guid column (guid generation collides for rules 2+ in a group).
#
# Measurement naming convention from gxadmin iquery:
#   gxadmin iquery jobs-queued          → measurement: jobs-queued,                          field: count
#   gxadmin iquery jobs-queued-internal → measurement: jobs-queued-internal-by-handler,      field: count
# System metrics from Telegraf plugins:
#   mem plugin   → measurement: mem,  field: used_percent
#   disk plugin  → measurement: disk, field: used_percent, tag: path
# Journalctl script:
#   galaxy-journalctl-monitor → measurement: galaxy_journal_errors, field: count, tag: level
# Job error script:
#   galaxy-job-error-stats    → measurement: galaxy_job_errors, field: count

apiVersion: 1

groups:

  # ── Job Queue ──────────────────────────────────────────────────────────────

  # sum(count) across both group tags (processed/unprocessed); gt 20.
  - orgId: 1
    name: Job Queue High
    folder: Galaxy Alerts
    interval: 2m
    rules:

      - uid: be-job-queue-high
        title: High Job Queue Depth (prod)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT sum("count") FROM "jobs-queued"
                WHERE "host" = 'usegalaxy.be' AND $timeFilter
                GROUP BY time($__interval) fill(0)
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [20]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: OK
        execErrState: Error
        for: 5m
        labels:
          severity: warning
          env: prod
        annotations:
          summary: Job queue depth is above 20 on prod
          description: >-
            The job queue on usegalaxy.be has been above 20 for 5+ minutes.
            Check: condor_q, gxadmin query queue-overview

      - uid: be-job-queue-high-test
        title: High Job Queue Depth (test)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT sum("count") FROM "jobs-queued"
                WHERE "host" = 'test.usegalaxy.be' AND $timeFilter
                GROUP BY time($__interval) fill(0)
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [20]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: OK
        execErrState: Error
        for: 5m
        labels:
          severity: warning
          env: test
        annotations:
          summary: Job queue depth is above 20 on test
          description: >-
            The job queue on test.usegalaxy.be has been above 20 for 5+ minutes.
            This may indicate insufficient compute slots or HTCondor issues.
            Check: condor_q, gxadmin query queue-overview

