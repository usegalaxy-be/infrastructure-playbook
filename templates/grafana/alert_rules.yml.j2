          description: >-
            test.usegalaxy.be memory usage has been above 90% for 5+ minutes.
            Consider restarting Galaxy handlers or investigating memory leaks.

  # Two tiers, both with a recovery threshold (hysteresis). 85% is a ticket: a
  # 30GB root disk crossing it needs attention today, not a page. The page only
  # fires when there is genuinely too little room left to work in.
  # The recovery thresholds are what stop the alert re-firing while usage sits
  # on the line, which is what produced the hourly repeats before.
  - orgId: 1
    name: Disk Root High
    folder: Galaxy Alerts
    interval: 5m
    rules:

      # Host was inventory_hostname (= monitoring host); hardcoded below.
      - uid: be-disk-root-high
        title: Root Disk Usage High (prod)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT max("used_percent") FROM "disk"
                WHERE "host" = 'usegalaxy.be' AND "path" = '/'
                AND $timeFilter
              refId: A
          - refId: B
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: __expr__
            model:
              type: reduce
              refId: B
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              refId: C
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - type: query
                  evaluator:
                    type: gt
                    params: [85]
                  unloadEvaluator:
                    type: lt
                    params: [80]
        noDataState: NoData
        execErrState: Error
        for: 1h
        labels:
          severity: warning
          env: prod
        annotations:
          summary: Root disk on prod above 85% used (clears below 80%)
          description: >-
            usegalaxy.be root disk (/) has been above 85% for an hour.
            ssh usegalaxy.be 'df -h /'
            ssh usegalaxy.be 'sudo du -xh --max-depth=2 / | sort -rh | head -20'
            Known space sinks and the cleanup playbook are in
            docs/monitoring/alerting.md

      - uid: be-disk-root-critical
        title: Root Disk Nearly Full (prod)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 1800
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT min("free") FROM "disk"
                WHERE "host" = 'usegalaxy.be' AND "path" = '/'
                AND $timeFilter
              refId: A
          - refId: B
            relativeTimeRange:
              from: 1800
              to: 0
            datasourceUid: __expr__
            model:
              type: reduce
              refId: B
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              refId: C
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - type: query
                  evaluator:
                    type: lt
                    params: [2000000000]
                  unloadEvaluator:
                    type: gt
                    params: [4000000000]
        noDataState: NoData
        execErrState: Error
        for: 10m
        labels:
          severity: critical
          env: prod
        annotations:
          summary: Root disk on prod has under 2GB free (clears above 4GB)
          description: >-
            usegalaxy.be root disk (/) is nearly full. Galaxy, condor and
            journald all write here, and things start failing below ~1GB.
            ssh usegalaxy.be 'df -h /'
            ssh usegalaxy.be 'sudo du -xh --max-depth=2 / | sort -rh | head -20'

      - uid: be-disk-root-high-test
        title: Root Disk Usage High (test)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT max("used_percent") FROM "disk"
                WHERE "host" = 'test.usegalaxy.be' AND "path" = '/'
                AND $timeFilter
              refId: A
          - refId: B
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: __expr__
            model:
              type: reduce
              refId: B
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              refId: C
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - type: query
                  evaluator:
                    type: gt
                    params: [85]
                  unloadEvaluator:
                    type: lt
                    params: [80]
        noDataState: NoData
        execErrState: Error
        for: 1h
        labels:
          severity: warning
          env: test
        annotations:
          summary: Root disk on test above 85% used (clears below 80%)
          description: >-
            test.usegalaxy.be root disk (/) has been above 85% for an hour.
            ssh test.usegalaxy.be 'df -h /'

  # Replaces "Disk Galaxy High" (no host/path filter). Scoped to the actual
  # NFS share; percentage tier is informational, free-space tier is critical.
  - orgId: 1
    name: NFS Data Share Usage
    folder: Galaxy Alerts
    interval: 5m
    rules:

      - uid: be-nfs-share-high
        title: NFS Data Share Usage High (informational)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT last("used_percent") FROM "disk"
                WHERE "host" = 'nfs.usegalaxy.be' AND "path" = '/data/share'
                AND $timeFilter
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [90]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: NoData
        execErrState: Error
        for: 30m
        labels:
          severity: info
          env: prod
        annotations:
          summary: NFS data share above 90% used
          description: >-
            The NFS data share (nfs.usegalaxy.be:/data/share) is above 90% used.
            Check: df -h /data/share on nfs.usegalaxy.be

      - uid: be-nfs-share-critical
        title: NFS Data Share Nearly Full (critical)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT last("free") FROM "disk"
                WHERE "host" = 'nfs.usegalaxy.be' AND "path" = '/data/share'
                AND $timeFilter
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: lt
                    params: [250000000000]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: NoData
        execErrState: Error
        for: 10m
        labels:
          severity: critical
          env: prod
        annotations:
          summary: NFS data share has less than 250GB free
          description: >-
            The NFS data share (nfs.usegalaxy.be:/data/share) has less than
            250GB free. Check: df -h /data/share on nfs.usegalaxy.be

  # ── Galaxy Application Errors ─────────────────────────────────────────────

  - orgId: 1
    name: Galaxy Log Errors
    folder: Galaxy Alerts
    interval: 1m
    rules:

      - uid: be-galaxy-log-errors
        title: Galaxy Log Error Spike (prod)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT sum("count") FROM "galaxy_journal_errors"
                WHERE "level" = 'error' AND "host" = 'usegalaxy.be' AND $timeFilter
                GROUP BY time(1m) fill(0)
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [20]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: max
                    params: []
                  type: query
        noDataState: NoData
        execErrState: Error
        for: 2m
        labels:
          severity: warning
          env: prod
        annotations:
          summary: More than 20 Galaxy ERROR log lines in 1 minute on prod
          description: >-
            usegalaxy.be Galaxy services are logging more than 20 ERROR-level lines per minute.
            Check: journalctl -u 'galaxy*' --since '5 minutes ago' | grep ERROR

      - uid: be-galaxy-log-errors-test
        title: Galaxy Log Error Spike (test)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: be-galaxy-new
            model:
