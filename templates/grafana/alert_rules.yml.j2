  # ── OOM kills ────────────────────────────────────────────────────────────────
  # Data source: kernel_vmstat oom_kill (telegraf, Galaxy hosts), a counter since
  # boot; non_negative_difference turns it into kills per minute.
  - orgId: 1
    name: OOM Kill prod
    folder: Galaxy Alerts
    interval: 5m
    rules:

      - uid: be-oom-kill
        title: Process OOM-Killed (prod)
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT non_negative_difference(last("oom_kill")) FROM "kernel_vmstat"
                WHERE "host" = 'usegalaxy.be' AND $timeFilter
                GROUP BY time(1m) fill(none)
              refId: A
          - refId: B
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: __expr__
            model:
              type: reduce
              refId: B
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: sum
              settings:
                mode: dropNN
          - refId: C
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              refId: C
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - type: query
                  evaluator:
                    type: gt
                    params: [0]
        noDataState: OK
        execErrState: Error
        for: 0s
        labels:
          severity: warning
          env: prod
        annotations:
          summary: >-
            The kernel OOM-killed a process on prod
          description: >-
            The kernel OOM killer fired on usegalaxy.be in the last 15 minutes. A service with
            Restart=always comes back by itself, so it never shows as a failed unit.
            ssh usegalaxy.be 'sudo journalctl -k --since -1h | grep -i "killed process"'

