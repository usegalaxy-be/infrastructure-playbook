              hide: false
              rawQuery: true
              query: >-
                SELECT sum("count") FROM "galaxy_journal_errors"
                WHERE "level" = 'error' AND "host" = 'test.usegalaxy.be' AND $timeFilter
                GROUP BY time(1m) fill(0)
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [20]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: max
                    params: []
                  type: query
        noDataState: NoData
        execErrState: Error
        for: 2m
        labels:
          severity: warning
          env: test
        annotations:
          summary: More than 20 Galaxy ERROR log lines in 1 minute on test
          description: >-
            test.usegalaxy.be Galaxy services are logging more than 20 ERROR-level lines per minute.
