  # ── System Resources ───────────────────────────────────────────────────────

  - orgId: 1
    name: Memory High
    folder: Galaxy Alerts
    interval: 1m
    rules:

      # Host was inventory_hostname (= monitoring host); hardcoded below.
      - uid: be-memory-high
        title: High Memory Usage (prod)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT mean("used_percent") FROM "mem"
                WHERE "host" = 'usegalaxy.be' AND $timeFilter
                GROUP BY time($__interval) fill(none)
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [90]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: NoData
        execErrState: Error
        for: 5m
        labels:
          severity: warning
          env: prod
        annotations:
          summary: Memory usage above 90% on prod
          description: >-
            usegalaxy.be memory usage has been above 90% for 5+ minutes.
            Consider restarting Galaxy handlers or investigating memory leaks.

      - uid: be-memory-high-test
        title: High Memory Usage (test)
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: be-galaxy-new
            model:
              datasource:
                type: influxdb
                uid: be-galaxy-new
              hide: false
              rawQuery: true
              query: >-
                SELECT mean("used_percent") FROM "mem"
                WHERE "host" = 'test.usegalaxy.be' AND $timeFilter
                GROUP BY time($__interval) fill(none)
              refId: A
          - refId: B
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: __expr__
            model:
              type: classic_conditions
              refId: B
              datasource:
                name: Expression
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [90]
                  operator:
                    type: and
                  query:
                    params: [A]
                  reducer:
                    type: last
                    params: []
                  type: query
        noDataState: NoData
        execErrState: Error
