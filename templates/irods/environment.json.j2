{
    "irods_host": "{{ vault_irods_host }}",
    "irods_port": "{{ vault_irods_port }}",
    "irods_zone_name": "{{ vault_irods_zone }}",
    "irods_authentication_scheme": "native",
    "irods_encryption_algorithm": "AES-256-CBC",
    "irods_encryption_salt_size": 8,
    "irods_encryption_key_size": 32,
    "irods_encryption_num_hash_rounds": 8,
    "irods_user_name": "{{ vault_irods_user }}",
    "irods_ssl_ca_certificate_file": "",
    "irods_ssl_verify_server": "cert",
    "irods_client_server_negotiation": "request_server_negotiation",
    "irods_client_server_policy": "CS_NEG_REQUIRE",
    "irods_default_resource": "default",
    "irods_cwd": "{{ vault_irods_cwd }}"
}