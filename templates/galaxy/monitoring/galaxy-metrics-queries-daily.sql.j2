        WHEN substring(gu.email from position('@' in gu.email) + 1) ILIKE 'PXL.%' THEN 'PXL'
        WHEN substring(gu.email from position('@' in gu.email) + 1) ILIKE 'VIVES.%' THEN 'VIVES'
        WHEN substring(gu.email from position('@' in gu.email) + 1) ILIKE 'KDG.%' THEN 'KDG'
        WHEN substring(gu.email from position('@' in gu.email) + 1) ILIKE 'ODISEE.%' THEN 'ODISEE'
        WHEN substring(gu.email from position('@' in gu.email) + 1) ILIKE 'THOMASMORE.%' THEN 'THOMASMORE'
        ELSE 'Others'
    END AS institution,
    CASE
        WHEN LOWER(gu.email) = ANY(ARRAY[{% for email in vault_vib_data_core_emails %}'{{ email }}'{% if not loop.last %}, {% endif %}{% endfor %}]) THEN 'true'
        ELSE 'false'
    END AS is_vib_data_core,
    COUNT(job.id) AS jobs_submitted,
    COUNT(job.id) FILTER (
        WHERE EXISTS (
            SELECT 1 FROM job_state_history jsh
            WHERE jsh.job_id = job.id AND jsh.state = 'running'
        )
    ) AS jobs_executed,
    COUNT(job.id) FILTER (
        WHERE NOT EXISTS (
            SELECT 1 FROM job_state_history jsh
            WHERE jsh.job_id = job.id AND jsh.state = 'running'
        )
    ) AS jobs_never_executed
FROM galaxy_user gu
JOIN job ON job.user_id = gu.id
WHERE job.create_time >= date_trunc('day', current_date - interval '1 day')
    AND job.create_time < date_trunc('day', current_date)
GROUP BY institution, is_vib_data_core
ORDER BY jobs_submitted DESC;

