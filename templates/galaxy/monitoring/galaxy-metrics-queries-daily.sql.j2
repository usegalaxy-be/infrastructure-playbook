-- CATEGORY: Jobs executed - Flemish institutions
-- DESCRIPTION: Jobs submitted yesterday per Flemish institution: how many ever reached the running state vs never executed.
-- "Executed" = job_state_history ever recorded a 'running' row, not job.state = 'paused'.
-- job.state is a live/mutable field: a job stuck in 'paused' today can be
-- deleted/cancelled by its owner later, which would silently move it out of a
-- state-based never-executed count. job_state_history is append-only, so this
-- stays accurate regardless of later cleanup.
SELECT
    CASE
        WHEN LOWER(substring(gu.email from position('@' in gu.email) + 1)) SIMILAR TO '%(vib|psb|ccb|cmb|csb|cbd|cfm|nerf|irc|cmn)%' THEN 'VIB'
