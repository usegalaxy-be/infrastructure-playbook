        WHEN LOWER(gu.email) = ANY(ARRAY[{% for email in vault_vib_data_core_emails %}'{{ email }}'{% if not loop.last %}, {% endif %}{% endfor %}]) THEN 'true'
        ELSE 'false'
    END AS is_vib_data_core,
    ROUND(COALESCE(SUM((a.metric_value * b.metric_value) / 3600), 0)::numeric, 3) AS cpu_hours
FROM galaxy_user gu
JOIN job ON job.user_id = gu.id
JOIN job_metric_numeric a ON a.job_id = job.id AND a.metric_name = 'runtime_seconds'
