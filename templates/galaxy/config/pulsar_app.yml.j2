---

# The path where per-job staging directories will be created.
# Each interactive tool job gets its own subdirectory here, and only
# those files are mounted into the container (unlike the default which
# mounts the entire Galaxy data directory).
staging_directory: "{{ galaxy_job_working_directory }}/_interactive"

# Where Pulsar state information is stored (e.g. currently active jobs)
persistence_directory: "{{ galaxy_mutable_data_dir }}/pulsar"

# Where to find Galaxy tool dependencies
tool_dependency_dir: "{{ galaxy_tool_dependency_dir }}"

conda_auto_init: false

# Use an in-process Python queue manager (no external AMQP needed)
managers:
  _default_:
    type: queued_condor