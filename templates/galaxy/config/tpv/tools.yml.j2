  toolshed.g2.bx.psu.edu/repos/galaxy-australia/alphafold2/alphafold/.*:
    inherits: _docker
    gpus: 1
    cores: 12
    mem: 48
    context:
      alphafold_aa_length_max: 3000
      alphafold_max_input_sequences: 5
      alphafold_db: /data  # mount point inside the container
      max_concurrent_job_count_for_tool_user: 4
    params:
      singularity_enabled: false
      docker_enabled: true
      docker_run_extra_arguments: '--user $UID:$GID --gpus all --env ALPHAFOLD_AA_LENGTH_MIN=5 --env ALPHAFOLD_AA_LENGTH_MAX={alphafold_aa_length_max} --env ALPHAFOLD_MAX_SEQUENCES={alphafold_max_input_sequences} --env ALPHAFOLD_DB={alphafold_db} --env CUDA_CACHE_PATH=/dev/shm/nv_cache --env TMPDIR=/tmp'
      singularity_run_extra_arguments: "--nv --env ALPHAFOLD_AA_LENGTH_MIN=5 --env ALPHAFOLD_AA_LENGTH_MAX={alphafold_aa_length_max} --env ALPHAFOLD_MAX_SEQUENCES={alphafold_max_input_sequences} --env ALPHAFOLD_DB={alphafold_db} --env CUDA_CACHE_PATH=/dev/shm/nv_cache --env TMPDIR=/tmp"
    env:
    - name: SINGULARITYENV_ALPHAFOLD_AA_LENGTH_MIN
      value: "5"
    - name: SINGULARITYENV_ALPHAFOLD_AA_LENGTH_MAX
      value: "3000"
    - name: SINGULARITYENV_ALPHAFOLD_DB
      value: /data
    rules:
    - id: add_alphafold_db_volume
      if: True
      # Append the AlphaFold DB volume. Tool rules run before the destination is merged,
      # so entity.params['docker_volumes'] here holds _docker's value (galaxy_container_volumes.local);
      # no condor destination sets its own docker_volumes, so this survives the merge.
      # NOTE: 'if: True' is required — rules with only 'execute' and no 'if' never run (is_matching returns False).
      execute: |
        db_vol = '{{ alphafold_db_path }}/2.3:/data/2.3:ro'
        base = entity.params.get('docker_volumes', '')
        entity.params['docker_volumes'] = (base + ',' + db_vol) if base else db_vol
    scheduling:
      require:
        - gpu
        - docker


