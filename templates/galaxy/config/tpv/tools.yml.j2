  # Match all sra_tools versions (incl. 3.x) and sub-tools (fasterq_dump, fastq_dump,
  # sam_dump, sra_pileup). The previous rules only matched 2.9/2.10/2.11.0 and required
  # the id to end in _dump, so 3.x and sra_pileup ran without the host CA bind mount,
  # causing mbedtls cert failures. See usegalaxy-be/infrastructure-playbook#172.
  # The sra_tools wrapper's own configfile sets /http/timeout/read = "1000", which
  # ncbi-vdb reads as milliseconds (1s), not seconds. That's shorter than a normal
  # round trip to NCBI's SDL resolver, so every run fails instantly with "Failed to
  # call external services." Use NCBI_SETTINGS (not NCBI_VDB_CONFIG) to redirect
  # just the user-settings layer to a copy of the same settings with a corrected
  # timeout, deployed by daily-tpv-config.yml from
  # files/galaxy/config/tpv/sra_tools_ncbi_override.kfg. NCBI_SETTINGS still loads
  # through ncbi-vdb's normal cascade (see libs/kfg/config.c), so the container's
  # own default.kfg (needed for RefSeq/WGS reference resolution) still loads too —
  # NCBI_VDB_CONFIG was tried first but short-circuits that whole cascade, silently
  # breaking reference resolution. Reported upstream: galaxyproject/tools-iuc#8316.
  toolshed.g2.bx.psu.edu/repos/iuc/sra_tools/.*:
    inherits: _singularity_resolv_fix
    params:
      singularity_run_extra_arguments: >-
        --no-mount=tmp
        -B {{ sra_tools_ncbi_override_path }}:{{ sra_tools_ncbi_override_path }}:ro
        --env NCBI_SETTINGS={{ sra_tools_ncbi_override_path }}
  toolshed.g2.bx.psu.edu/repos/iuc/tbvcfreport/tbvcfreport/0\.1\..*: {inherits: _singularity_resolv_fix}
  toolshed.g2.bx.psu.edu/repos/iuc/trinotate/trinotate/3\.[12]\.1: {inherits: _singularity_resolv_fix}
  toolshed.g2.bx.psu.edu/repos/galaxyp/unipept/unipept/4.3.0: {inherits: _singularity_resolv_fix}

