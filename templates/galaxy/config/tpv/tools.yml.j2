  ##################################
  # TOOLS FOR TPV TESTING #
  ##################################
  # Used for TPV routing validation (tpv dry-run) and future job execution testing.
  # IDs are intentionally fake — no real Galaxy tool matches them.

  test-condor-singularity:
    params:
      container_override:
        - type: singularity
          shell: /bin/sh
          identifier: /cvmfs/singularity.galaxyproject.org/all/python:3.8.3
    scheduling:
      require:
        - singularity
      reject:
        - pulsar

  test-condor-docker:
    params:
      singularity_enabled: false
      docker_enabled: true
      docker_run_extra_arguments: --user $UID:$GID
      container_override:
        - type: docker
          identifier: busybox:1.36.1-glibc
    scheduling:
      require:
        - docker
      reject:
        - pulsar

  test-condor-conda:
    params:
      singularity_enabled: false
    scheduling:
      require:
        - conda
      reject:
        - singularity
        - pulsar

  # $-anchored: tool ids are matched as regex, so a bare "test-condor-gpu" also prefix-matches
  # "test-condor-gpu-v3" and would wrongly add the gpu tag to it (→ no matching destination).
  test-condor-gpu$:
    gpus: 1
    params:
      container_override:
        - type: singularity
          shell: /bin/sh
          identifier: /cvmfs/singularity.galaxyproject.org/all/python:3.8.3
    scheduling:
      require:
