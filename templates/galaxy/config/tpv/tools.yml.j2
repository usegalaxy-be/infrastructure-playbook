    #cores: 8
    #mem: 30.7
    rules:
    - id: fastqc_conda_rule
      if: helpers.tool_version_lt(tool, '0.72+galaxy1')
      # Older bioconda Singularity images use a custom OpenJDK build lacking
      # fontconfig.bfc, causing an intermittent NPE in report generation.
      params:
        singularity_enabled: false
      scheduling:
        require:
          - conda
    - id: fastqc_singularity_rule
      if: |
        minimum_singularity_version = '0.72+galaxy1'
        helpers.tool_version_gte(tool, minimum_singularity_version)
      params:
        singularity_enabled: true
      scheduling:
        require:
          - singularity
