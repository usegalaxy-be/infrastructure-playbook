  toolshed.g2.bx.psu.edu/repos/ieguinoa/load_ref_data/load_reference_datasets/.*: {inherits: _conda_local}

  __DATA_FETCH__:
    cores: 1
    mem: 5
    params:
      tmp_dir: true
    rules:
    - id: no-pulsar
      if: user is not None
      execute: |
          # user preferences for remote resources (pulsar), not currently set up on this instance
          # TPV v3: SchedulingTags.require/prefer/accept/reject are list[str]; .tags is read-only.
          user_preferences = user.extra_preferences
          pulsar_value = user_preferences.get("distributed_compute|remote_resources", "None")

          if pulsar_value != "None":
              entity.tpv_tags.require = [t for t in (entity.tpv_tags.require or []) if t != pulsar_value]
    # Temporary rule to allow tool admin to use new internal nfs shares for testing
    # - id: tool-test
    #   if: user is tool_admin@test.be
    #   params:
    #     object_store_id: "new_internal_nfs_shares"
    #   # Rule to disallow anonymous users to run jobs
    # - id: requires_login
    #   if: not user
    #   fail: |
    #     You must be logged in to use this Galaxy instance

  # __SET_METADATA__: {inherits: _galaxy_lib_local}

  # currently not used
  export_remote:
    inherits: _conda_local
    # TEMP: https://tracker.ceph.com/issues/63153, below should not needed once JS2 is upgraded to Ceph 18.2.5
    env:
    - name: AWS_REQUEST_CHECKSUM_CALCULATION
      value: when_required
    - name: AWS_RESPONSE_CHECKSUM_VALIDATION
      value: when_required

  .*testing.*:
    inherits: _conda_local
    cores: 2
    mem: cores * 4
    rules:
      - id: admin_only_testing_tool
        if: |
          # Only allow the tool to be executed if the user is an admin
          admin_users = app.config.admin_users
          # last line in block must evaluate to a value - which determines whether the TPV if conditional matches or not
          not user or user.email not in admin_users
        fail: Unauthorized. Only admins can execute this tool.
      - id: resource_params_defined
        if: |
          param_dict = job.get_param_values(app)
          param_dict.get('__job_resource', {}).get('__job_resource__select') == 'yes'
        cores: int(job.get_param_values(app)['__job_resource']['cores'])
        params:
           walltime: "{int(job.get_param_values(app)['__job_resource']['time'])}"

  .*protein_calculator.*:
    cores: 4
    mem: 8
    params:
      singularity_enabled: true
      object_store_id: "new_internal_nfs_shares"
      # test: avoid the ~10s fresh-process import cost of external metadata setting
      metadata_strategy: directory_celery
    scheduling:
       require:
         - singularity
         - local-tool
       reject:
         - pulsar

