---
# ALL tags must be with dashes (-) instead of underscores (_)
# There is a set of defaults in https://raw.githubusercontent.com/galaxyproject/tpv-shared-database/main/tools.yml
tools:
  #
  # Abstract tools for inheritance
  #

  # Tools that require a local conda environment (i.e. not singularity or pulsar)
  _conda_local:
    abstract: true
    # https://github.com/galaxyproject/total-perspective-vortex/issues/118
    #inherits: ''
    params:
      singularity_enabled: false
      docker_enabled: false
    scheduling:
      require:
      - conda
      reject:
      - singularity
      - pulsar
      - offline

  # Tools for which no specific singularity container is defined, but can/should run using singularity and the Galaxy Python environment
  _galaxy_lib:
    # NOTE: changes here need to be reflected in the rules on the default tool
    abstract: true
    #inherits: ''
    params:
      container_override:
      - type: singularity
        shell: /bin/sh
        identifier: /cvmfs/main.galaxyproject.org/singularity/rockylinux:9.5.20241118--0
    env:
    - name: SINGULARITYENV_PREPEND_PATH
      value: $GALAXY_VIRTUAL_ENV/bin
    - name: SINGULARITYENV_PYTHONPATH
      value: $GALAXY_LIB
    scheduling:
      require:
      - singularity
      reject:

  # Tools for which no specific singularity container is defined, but can/should run using singularity and the Galaxy Python environment, 
  # but not on pulsar
  _galaxy_lib_local:
    abstract: true
    inherits: _galaxy_lib
    scheduling:
      reject:
      - pulsar

  # Legacy tools using conda-in-singularity environment, created and maintained by usegalaxy.org
  _legacy:
    abstract: true
    params:
      container_override:
      - type: singularity
        shell: /bin/bash
        # NOTE: This setting causes conda dependencies to be installed if missing.
        resolve_dependencies: true
        identifier: /cvmfs/main.galaxyproject.org/singularity/usegalaxy.org-legacy-environment--0
    env:
    - name: LC_ALL
      value: C
    - name: SINGULARITYENV_LC_ALL
      value: $LC_ALL
    scheduling:
      require:
      - singularity
      reject:
      - offline

  _conda_in_container:
    abstract: true
    env:
      # TPV is not passing ENV vars into the containers as it seems (2026-01), so lets set this for all containers and pass in with "SINGULARITYENV_"
      - name: _JAVA_OPTIONS
        value: -Djava.io.tmpdir=$_GALAXY_JOB_TMP_DIR -Xmx{round(mem*0.9*1024)}m -Xms256m
      - name: SINGULARITYENV__JAVA_OPTIONS
        value: $_JAVA_OPTIONS
    scheduling:
      require:
        - conda
        - singularity

  # Legacy tools using conda-in-singularity environment, created and maintained by usegalaxy.org, but not on pulsar
  _legacy_local:
    abstract: true
    inherits: _legacy
    scheduling:
      reject:
      - pulsar

  # Fix for singularity resolver issues with some containers, currently not used for this instance, defined by usegalaxy.org
  _singularity_resolv_fix:
    abstract: true
    params:
      # this doesn't override dest params
      #singularity_no_mount: tmp
      singularity_run_extra_arguments: --no-mount=tmp
    env:
    - name: SINGULARITY_BIND
      value: /etc/pki:/etc/pki:ro,/etc/ssl:/etc/ssl::ro
  
  # Perl tools using perl 5.26.2 container from galaxyproject.org
  _perl_5_26_2:
    abstract: true
    params:
      container_override: [{type: singularity, shell: '/bin/sh', identifier: "/cvmfs/singularity.galaxyproject.org/all/perl:5.26.2"}]
    env:
    - name: LC_ALL
      value: C
    - name: SINGULARITYENV_LC_ALL
      value: $LC_ALL

  # Base abstract for all docker tools.
  # --user $UID:$GID runs the container as the user executing the job (1001 on condor
  # workers, 491 on VIB Pulsar) — no hardcoded uid needed at the destination level.
  # Tools that need root (e.g. _novnc_it, pavian) override docker_run_extra_arguments.
  _docker:
    abstract: true
    params:
      docker_run_extra_arguments: --user $UID:$GID
      docker_enabled: true
      singularity_enabled: false
      docker_volumes: "{{ galaxy_container_volumes.local | join(',') }}"
    scheduling:
      require:
        - docker
  
  # Abstract for SPAdes-family assemblers — input-size-based scaling (adapted from usegalaxy.eu)
  # Tiers: <5 MB→2c/default, 5 MB-1 GB→8c/100G, 1-2 GB→12c/200G, 2-20 GB→20c/350G, >=20 GB→fail
  _spades:
    abstract: true
    cores: 2
    scheduling:
      require:
        - singularity
    rules:
      - if: 0.005 <= input_size < 1
        cores: 8
        mem: 100
      - if: 1 <= input_size < 2
        cores: 12
        mem: 200
      - if: 2 <= input_size < 20
        cores: 20
        mem: 350
      - if: input_size >= 20
        fail: "Input data too large for this assembler. Please contact support or downsample your reads."

