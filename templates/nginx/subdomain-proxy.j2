# Maintenance bypass: requests from the internal network with "X-Maintenance-Bypass: 1"
# reach Galaxy while maintenance mode is on, for checks before switching it off.
geo $maintenance_internal {
    default 0;
    10.113.3.0/24 1;
}
map "$maintenance_internal:$http_x_maintenance_bypass" $maintenance_bypass {
    default 0;
    "1:1" 1;
}

{% for subdomain in subdomains %}

# forwards from proxy to {{ subdomain }}
server {
    # Listen on port 443
	listen        *:443 ssl;
    # The virtualhost is our domain name
    server_name   {{ subdomain }};

    # Our log files will go here.
    access_log  /var/log/nginx/access.log;
    error_log   /var/log/nginx/error.log;

    # Manually blocked IPs (scanner/attacker blocks — replace with fail2ban when deployed)
    deny 185.177.72.11;

    # Maintenance page, answered with 503 so monitors and API clients see the outage.
    # The flag file is managed by 00-proxy.yml --tags maintenance (nginx_maintenance_sites).
    error_page 503 @maintenance;
    location @maintenance {
        rewrite ^ /maintenance break;
        proxy_pass https://usegalaxy-be.github.io;
        proxy_set_header Host usegalaxy-be.github.io;
        proxy_ssl_server_name on;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_hide_header ETag;
        proxy_hide_header Last-Modified;
        add_header Cache-Control "no-store" always;
        add_header Retry-After 300 always;
    }

    # Drop common vulnerability scan targets (wp-config, .env files, php probes)
    location ~* "(\.env(\.|$)|wp-config\.php|\.php$|/config\.env$)" {
        return 444;
    }

    location /api/upload/resumable_upload {
        set $maintenance "";
        if (-f /var/www/html/maintenance-{{ subdomain }}) {
            set $maintenance "on";
        }
        if ($maintenance_bypass) {
            set $maintenance "";
        }
        if ($maintenance = "on") {
            return 503;
        }

        # Disable request and response buffering (required for TUS chunked uploads)
        proxy_request_buffering off;
        proxy_buffering         off;
        proxy_http_version      1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";

        client_max_body_size 0;
        proxy_pass https://{{ subdomain }};
    }

    location / {
        set $maintenance "";
        if (-f /var/www/html/maintenance-{{ subdomain }}) {
            set $maintenance "on";
        }
        if ($maintenance_bypass) {
            set $maintenance "";
        }
        if ($maintenance = "on") {
            return 503;
        }

        # This is the backend to send the requests to.
        proxy_pass https://{{ subdomain }};

        proxy_set_header Host {{ subdomain }};
        proxy_set_header X-Forwarded-For $remote_addr;
        # proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        #proxy_set_header X-Real-IP $remote_addr;
    }
    ssl_certificate     {{ nginx_conf_ssl_certificate }};
    ssl_certificate_key {{ nginx_conf_ssl_certificate_key }};

}

{% endfor %}